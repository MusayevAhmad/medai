# =============================================================================
# BioScholar .gitignore
# =============================================================================

# --- Model Checkpoints & Large Weights ---
outputs/
*.pt
*.pth
*.safetensors
*.bin
*.ckpt
*.onnx

# --- Data & Generated Assets ---
data/raw_pdfs/
data/figures/
data/qdrant_db/
data/finetune/
data/processed/
data/xray/
data/hf_cache/
*.arrow
*.pdf

# --- MLflow & Experiment Tracking ---
mlruns/
mlflow.db
wandb/
.wandb/

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.tox/

# --- Python Bytecode & Packaging ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# --- Virtual Environments ---
venv/
env/
.venv/
ENV/

# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example

# --- Database Files ---
*.db
*.sqlite
*.sqlite3

# --- Logs ---
*.log
logs/
outputs/logs/

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- IDE & OS Files ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Temporary Files ---
*.tmp
*.temp
results/
