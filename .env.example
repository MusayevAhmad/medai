# BioScholar Environment Variables
# Copy to .env and fill in values as needed.

# ---------------------------------------------------------------------------
# Qdrant (vector database)
# ---------------------------------------------------------------------------
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_PATH=data/qdrant_db
# QDRANT_COLLECTION=bio_guidelines

# ---------------------------------------------------------------------------
# NER Model
# ---------------------------------------------------------------------------
# NER_MODEL_PATH=outputs/models/run_xxx/final_model

# ---------------------------------------------------------------------------
# LLM (Ollama or OpenAI-compatible API)
# ---------------------------------------------------------------------------
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# ---------------------------------------------------------------------------
# LangSmith Observability (Task 5.3)
# Enable agent tracing and view full traces at https://smith.langchain.com
# ---------------------------------------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=bioscholar
