FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements_streamlit_demo.txt /app/requirements_streamlit_demo.txt
RUN pip install --no-cache-dir -r /app/requirements_streamlit_demo.txt

COPY streamlit_app /app/streamlit_app

RUN mkdir -p /app/data/raw_pdfs /app/data/figures

EXPOSE 8501

CMD ["streamlit", "run", "streamlit_app/app.py", "--server.address=0.0.0.0", "--server.port=8501"]

